# ========================================
# MySQL Database Configuration
# ========================================

# For Local MySQL (Testing Only)
MYSQL_URL=jdbc:mysql://localhost:3306/posdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# For Cloud MySQL - Railway (RECOMMENDED for Multi-User)
# MYSQL_URL=jdbc:mysql://containers-us-west-xxx.railway.app:1234/railway?useSSL=true
# MYSQL_USER=root
# MYSQL_PASSWORD=your_railway_password

# For Cloud MySQL - Aiven
# MYSQL_URL=jdbc:mysql://your-service.aivencloud.com:12345/defaultdb?useSSL=true
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=your_aiven_password

# ========================================
# Cloudinary Configuration (Image Storage)
# ========================================
# Sign up at: https://cloudinary.com/users/register/free
# Free tier: 25GB storage, 25GB bandwidth/month

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========================================
# Notes:
# ========================================
# 1. Never commit this file with real credentials
# 2. Copy this to .env and fill in your actual values
# 3. Images are stored in Cloudinary (NOT in database) for better performance
# 4. Database only stores image URLs (prevents lag)
